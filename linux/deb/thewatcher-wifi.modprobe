# The Watcher: sin ahorro de energía en los drivers Wi-Fi que más se cuelgan (se aplica al reiniciar).
# Las líneas de drivers que esta PC no tiene se ignoran.
options rtl8723be fwlps=0 ips=0 aspm=0
options rtl8723ae fwlps=0 ips=0 aspm=0
options rtl8188ee fwlps=0 ips=0 aspm=0
options rtl8192ee fwlps=0 ips=0 aspm=0
options rtl8821ae fwlps=0 ips=0 aspm=0
options rtw88_core disable_lps_deep=y
options rtw88_pci disable_aspm=y
options rtw89_core disable_ps_mode=y
options rtw89_pci disable_clkreq=y disable_aspm_l1=y disable_aspm_l1ss=y
# Intel (7265 y similares): sin pelea con el Bluetooth por la antena y con agregación de paquetes
options iwlwifi power_save=0 bt_coex_active=0 11n_disable=8
options iwlmvm power_scheme=1
options ath9k ps_enable=0
# Adaptadores Wi-Fi USB (Realtek con drivers externos): sin ahorro de energía ni suspensión USB
options 8188eu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8188fu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8192eu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8723du rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8812au rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8814au rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8821au rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 88XXau rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8821cu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 8822bu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options 88x2bu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
options r8188eu rtw_power_mgnt=0 rtw_enusbss=0 rtw_ips_mode=0
# Realtek USB del kernel (rtw88): sin modo de bajo consumo profundo (ya puesto arriba en rtw88_core)
options rtw88_usb switch_usb_mode=y
# Ralink/MediaTek y Atheros USB no tienen ahorro configurable: los cubre la regla USB (sin suspensión)
